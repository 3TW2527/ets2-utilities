<Window x:Class="Ets2u.App.TrafficLightOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ETS2 Utilities traffic light" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border Background="#D0101418" CornerRadius="18" Padding="10,8">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="GreenLamp" Width="22" Height="22" Margin="0,0,8,0"/>
            <Ellipse x:Name="YellowLamp" Width="22" Height="22" Margin="0,0,8,0"/>
            <Ellipse x:Name="RedLamp" Width="22" Height="22"/>
        </StackPanel>
    </Border>
</Window>
