<Window x:Class="Ets2u.App.GForceMeter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ETS2 Utilities g-force" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="Segoe UI">
    <Border Background="#D0101418" CornerRadius="8" Padding="12,8,12,10" Cursor="SizeAll">
        <StackPanel>
            <DockPanel>
                <Button x:Name="ResetButton" DockPanel.Dock="Right" Content="Reset peaks" FontSize="11" Padding="6,1"
                        Background="#33FFFFFF" Foreground="White" BorderBrush="#55FFFFFF" Cursor="Hand" Click="Reset_Click"/>
                <TextBlock x:Name="Heading" Foreground="#FFD7DCE2" FontSize="12" VerticalAlignment="Center" Text="G-force"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <!-- Friction circle: right is right, up is accelerating, down is braking. -->
                <Canvas x:Name="Plot" Width="150" Height="150" ClipToBounds="True">
                    <Ellipse x:Name="RedRing" Stroke="#E03A2F" StrokeThickness="1.5"/>
                    <Ellipse x:Name="YellowRing" Stroke="#F2B705" StrokeThickness="1.5"/>
                    <Line X1="0" Y1="75" X2="150" Y2="75" Stroke="#40FFFFFF"/>
                    <Line X1="75" Y1="0" X2="75" Y2="150" Stroke="#40FFFFFF"/>
                    <Polyline x:Name="Trail" Stroke="#80FFFFFF" StrokeThickness="1.5"/>
                    <Ellipse x:Name="Dot" Width="10" Height="10" Fill="White"/>
                </Canvas>
                <Grid Margin="14,0,0,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="1" Text="now" Foreground="#FF9AA3AE" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="peak" Foreground="#FF9AA3AE" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="1" Text="Accelerating" Foreground="White" FontSize="13" Margin="0,2,10,2"/>
                    <TextBlock Grid.Row="2" Text="Braking" Foreground="White" FontSize="13" Margin="0,2,10,2"/>
                    <TextBlock Grid.Row="3" Text="Left turn" Foreground="White" FontSize="13" Margin="0,2,10,2"/>
                    <TextBlock Grid.Row="4" Text="Right turn" Foreground="White" FontSize="13" Margin="0,2,10,2"/>
                    <TextBlock x:Name="AccelNow" Grid.Row="1" Grid.Column="1" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="BrakeNow" Grid.Row="2" Grid.Column="1" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="LeftNow" Grid.Row="3" Grid.Column="1" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="RightNow" Grid.Row="4" Grid.Column="1" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="AccelPeak" Grid.Row="1" Grid.Column="2" FontSize="13" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="BrakePeak" Grid.Row="2" Grid.Column="2" FontSize="13" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="LeftPeak" Grid.Row="3" Grid.Column="2" FontSize="13" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="RightPeak" Grid.Row="4" Grid.Column="2" FontSize="13" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
            <TextBlock x:Name="Footer" Foreground="#FF9AA3AE" FontSize="11" Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</Window>
