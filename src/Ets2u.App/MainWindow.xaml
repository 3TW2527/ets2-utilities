<Window x:Class="Ets2u.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ets2u.App"
        Title="ETS2 Utilities" Height="720" Width="1060" MinHeight="540" MinWidth="860"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Title">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="H">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Note">
            <Setter Property="Foreground" Value="#5A5A5A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>
        <!-- What you must see: a short line that always shows (the rest is in the info tips). -->
        <Style TargetType="TextBlock" x:Key="Must">
            <Setter Property="Foreground" Value="#7A4A00"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Status" BasedOn="{StaticResource Note}">
            <Setter Property="Foreground" Value="#1F5F99"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="StackPanel" x:Key="Page">
            <Setter Property="Margin" Value="20,16,20,20"/>
            <Setter Property="MaxWidth" Value="780"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style TargetType="Border" x:Key="ApplyBar">
            <Setter Property="Background" Value="#F3F6FA"/>
            <Setter Property="BorderBrush" Value="#D8E0EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>
        <Style TargetType="Border" x:Key="StepCard">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E0EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="Border" x:Key="StepNumber">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="#2F6FB0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisible"/>
        <local:ChevronAngleConverter x:Key="ChevronAngle"/>
        <DataTemplate x:Key="KeyValueRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="#5A5A5A"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>

        <!-- Left navigation: each TabItem is a row; Tag="group" rows are section captions. -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Row" Background="Transparent" Padding="14,6" Margin="0,1" CornerRadius="3">
                            <ContentPresenter x:Name="Text" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#E6ECF3"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#D3E3F5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="group">
                                <Setter TargetName="Row" Property="Padding" Value="8,14,8,2"/>
                                <Setter TargetName="Row" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#6A7280"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border x:Name="Banner" DockPanel.Dock="Top" Background="#FFF4E5" Padding="12,8" Visibility="Collapsed">
            <TextBlock x:Name="BannerText" Foreground="#8A4B00" TextWrapping="Wrap"/>
        </Border>
        <Border x:Name="UpdateBar" DockPanel.Dock="Top" Background="#E8F1FB" Padding="12,6" Visibility="Collapsed">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="UpdateNowButton" Content="Update now" Click="UpdateNow_Click" Margin="8,0,0,0" Padding="10,2"/>
                    <Button x:Name="UpdateNotesButton" Content="What's new" Click="UpdateNotes_Click" Margin="8,0,0,0" Padding="10,2"/>
                    <Button x:Name="UpdateLaterButton" Content="Later" Click="UpdateLater_Click" Margin="8,0,0,0" Padding="10,2"/>
                </StackPanel>
                <TextBlock x:Name="UpdateText" Foreground="#0B4A8B" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap"/>
            </StatusBarItem>
        </StatusBar>
        <TabControl x:Name="Nav" TabStripPlacement="Left" BorderThickness="1,0,0,0" BorderBrush="#D8E0EA" Padding="0"
                    Background="White">
            <TabControl.Resources>
                <Style TargetType="TabPanel">
                    <Setter Property="Background" Value="#F7F9FB"/>
                    <Setter Property="MinWidth" Value="190"/>
                    <Setter Property="Margin" Value="6,4,6,4"/>
                </Style>
            </TabControl.Resources>

            <!-- ================= OVERVIEW ================= -->
            <TabItem Header="OVERVIEW" Tag="group" IsEnabled="False" Focusable="False"/>

            <TabItem x:Name="ModsPageTab" Header="Start here">
                <DockPanel Margin="20,16,20,20">
                    <StackPanel DockPanel.Dock="Top" MaxWidth="900" HorizontalAlignment="Left">
                        <local:PageHeader Title="Start here" Subtitle="Three steps: pick what you want, apply it, then switch it on in the game."
                                          Info="Every mod the app makes is marked optional for Convoy and named with your own tag, so it never clashes with another player's copy."/>
                        <UniformGrid Columns="3" Margin="0,4,0,0">
                            <Border Style="{StaticResource StepCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <TextBlock Text="Pick" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="Choose a feature in the list on the left. Each page says what it does and what it needs."/>
                                    <TextBlock x:Name="StepPickStatus" Style="{StaticResource Status}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StepCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <TextBlock Text="Apply" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="Set it up and press Apply at the bottom of its page. Close ETS2 first: mods and saves can't change while it runs."/>
                                    <TextBlock x:Name="StepApplyStatus" Style="{StaticResource Status}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StepCard}" Margin="0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <TextBlock Text="Switch on in the game" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="Enable new mods once in the game's Mod Manager. Overlays, alerts and summaries need the plugin, installed once."/>
                                    <TextBlock x:Name="StepGameStatus" Style="{StaticResource Status}" Margin="0,8,0,0"/>
                                    <Button x:Name="StartInstallPluginButton" Content="Install plugin" Click="InstallPlugin_Click"
                                            HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <local:Heading Text="What's in the game"
                                       Info="Everything this app puts into the game, with its file and state. Double-click a row to open its page. After a game update the app rebuilds the mods by itself when it starts; Rebuild all mods does it now. After the app is updated it updates the plugin too, the next time it starts with ETS2 closed."/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Rebuild all mods" Click="RebuildAll_Click" Margin="0,0,8,6"/>
                            <Button x:Name="ReinstallPluginButton" Content="Reinstall plugin" Click="InstallPlugin_Click" Margin="0,0,8,6"/>
                            <Button x:Name="RemovePluginButton" Content="Remove plugin" Click="RemovePlugin_Click" Margin="0,0,8,6"/>
                            <Button Content="Open mod folder" Click="OpenModFolder_Click" Margin="0,0,8,6"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock x:Name="AppVersionText" VerticalAlignment="Center" Foreground="#5B6B7C" Margin="0,0,12,6"/>
                            <CheckBox x:Name="CheckUpdatesBox" Content="Check for updates when the app starts" VerticalAlignment="Center"
                                      Click="CheckUpdatesBox_Click" Margin="0,0,12,6"/>
                            <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click" Margin="0,0,8,6"/>
                            <local:InfoTip Margin="0,0,0,6" VerticalAlignment="Center"
                                           Text="The app looks at its latest release on GitHub. Update now downloads it, checks it against the release's SHA-256, closes the app, puts the new files in place and starts it again. Your settings and backups stay. If the plugin is installed, it's updated too the next time the app starts with ETS2 closed."/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="ModsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" CanUserAddRows="False" SelectionMode="Single"
                              MouseDoubleClick="ModsGrid_DoubleClick" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Feature" Binding="{Binding Name}" Width="170"/>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="60"/>
                            <DataGridTextColumn Header="File" Binding="{Binding File}" Width="210"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="GameTab" Header="Game &amp; profiles">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16,20,20">
                        <local:PageHeader Title="Game &amp; profiles" Subtitle="Where the app found ETS2, and your profiles and saves."/>
                        <ItemsControl x:Name="PathRows" ItemTemplate="{StaticResource KeyValueRow}" Margin="0,6,0,0"/>

                        <TextBlock Style="{StaticResource H}" Text="Profiles"/>
                        <DataGrid x:Name="ProfileGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Profile" Binding="{Binding Name}" Width="130"/>
                                <DataGridTextColumn Header="Stored in" Binding="{Binding Storage}" Width="100"/>
                                <DataGridTextColumn Header="Saves" Binding="{Binding SaveCount}" Width="55"/>
                                <DataGridTextColumn Header="Newest save" Binding="{Binding NewestSave}" Width="170"/>
                                <DataGridTextColumn Header="Save format" Binding="{Binding Format}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Refresh" Click="Refresh_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= MODS ================= -->
            <TabItem Header="MODS" Tag="group" IsEnabled="False" Focusable="False"/>

            <TabItem x:Name="NoDamageTab" Header="No damage">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <local:PageHeader Title="No damage" Subtitle="No damage or wear for trucks, coaches, trailers and cargo." Needs="Mod"
                                          Info="Mod: ets2u_nodamage. Built from the game's own damage file, so it follows game updates."/>
                        <CheckBox x:Name="NoDamageBox" Content="No damage or wear" Margin="0,8,0,0"/>
                        <TextBlock Style="{StaticResource Must}" Text="Turn off any Workshop &quot;No Damage&quot; mod: the two conflict."/>
                        <Border Style="{StaticResource ApplyBar}">
                            <StackPanel>
                                <Button Content="Apply" Click="ApplyNoDamage_Click" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="NoDamageStatus" Style="{StaticResource Status}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="EarningsTab" Header="Bigger earnings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <local:PageHeader Title="Bigger earnings" Subtitle="Multiplies the pay and XP of truck jobs." Needs="Mod"
                                          Info="Mod: ets2u_economy. Coach jobs have no pay or XP rates in the game files, so this only changes truck jobs. For coaches, set money and coach XP on the Money &amp; XP page."/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Job pay" VerticalAlignment="Center"/>
                            <Slider x:Name="IncomeSlider" Grid.Column="1" Minimum="1" Maximum="50" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Margin="0,4" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="IncomeLabel" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Grid.Row="1" Text="Job XP" VerticalAlignment="Center"/>
                            <Slider x:Name="XpSlider" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="50" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Margin="0,4" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="XpLabel" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Must}" Text="Truck jobs only. Turn off any Workshop money or XP mod: it overrides the same file."/>
                        <Border Style="{StaticResource ApplyBar}">
                            <StackPanel>
                                <Button Content="Apply" Click="ApplyEarnings_Click" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="EarningsStatus" Style="{StaticResource Status}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="CoachTab" Header="Coach passengers">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <local:PageHeader Title="Coach passengers" Subtitle="What upsets passengers, and how much g-force they take." Needs="Mod"
                                          Info="Mod: ets2u_coach."/>

                        <local:Heading Text="G-force: when passengers complain"
                                       Info="The game checks the g-force three ways: across the coach (cornering), up and down (bumps and crests) and along it (accelerating and braking). Past the normal limit passengers lose a little satisfaction; past the harsh one, a lot. The game itself has a harsh limit for braking only, so however hard you take a corner it costs only the small penalty; here every direction has one. The Stock starting point keeps the game's numbers (0.61 g normal) and uses its braking harsh limit (1.12 g) everywhere. The driving alerts can use these limits: yellow at the normal limit, red at the harsh one (Driving alerts page)."/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Text="Start from" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="GPresetBox" Width="150" SelectionChanged="GPreset_Changed"/>
                        </StackPanel>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" Text="Normal (g)" Foreground="#8A6A00"/>
                            <TextBlock Grid.Column="2" Text="Harsh (g)" Foreground="#B3261E"/>
                            <TextBlock Grid.Row="1" Text="Cornering" VerticalAlignment="Center"/>
                            <TextBox x:Name="GCornerBox" Grid.Row="1" Grid.Column="1" Margin="0,3,8,3"/>
                            <TextBox x:Name="GCornerHarshBox" Grid.Row="1" Grid.Column="2" Margin="0,3,8,3"/>
                            <TextBlock Grid.Row="2" Text="Bumps and crests" VerticalAlignment="Center"/>
                            <TextBox x:Name="GVerticalBox" Grid.Row="2" Grid.Column="1" Margin="0,3,8,3"/>
                            <TextBox x:Name="GVerticalHarshBox" Grid.Row="2" Grid.Column="2" Margin="0,3,8,3"/>
                            <TextBlock Grid.Row="3" Text="Accelerating and braking" VerticalAlignment="Center"/>
                            <TextBox x:Name="GBrakeBox" Grid.Row="3" Grid.Column="1" Margin="0,3,8,3"/>
                            <TextBox x:Name="GBrakeHarshBox" Grid.Row="3" Grid.Column="2" Margin="0,3,8,3"/>
                            <TextBlock Grid.Row="4" Text="Job fails above (braking)" VerticalAlignment="Center"/>
                            <TextBox x:Name="GFailureBox" Grid.Row="4" Grid.Column="1" Margin="0,3,8,3"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource Note}" VerticalAlignment="Center"
                                       Text="Empty: never (same as the switch below)"/>
                        </Grid>
                        <TextBlock x:Name="GLimitsNote" Style="{StaticResource Note}"/>

                        <local:Heading Text="What lowers satisfaction"
                                       Info="Anything left unticked works as normal, and rewards for smooth, on-time driving always stay. The game's g-force meter can be hidden with the game's own switch in its options."/>
                        <TextBlock Text="These no longer lower passenger satisfaction:" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="CoachFactorPanel" Margin="12,0,0,0">
                            <CheckBox Tag="DrivingStyle" Content="Driving style (any g-force, whatever the limits above)" Width="440" Margin="0,3"/>
                            <CheckBox Tag="Lateness" Content="Arriving late" Width="220" Margin="0,3"/>
                            <CheckBox Tag="Speeding" Content="Speeding" Width="440" Margin="0,3"/>
                            <CheckBox Tag="Crashes" Content="Crashes" Width="220" Margin="0,3"/>
                            <CheckBox Tag="CoachWear" Content="Coach wear and damage" Width="440" Margin="0,3"/>
                            <CheckBox Tag="Offences" Content="Traffic offences (fines)" Width="220" Margin="0,3"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,4,0,0">
                            <Button Content="Tick all" Click="CoachAll_Click" Padding="10,2"/>
                            <Button Content="Clear" Click="CoachNone_Click" Padding="10,2"/>
                        </StackPanel>
                        <CheckBox x:Name="CoachJobFailureBox" Content="Extreme g-force no longer fails the job" Margin="0,10,0,0"/>
                        <CheckBox x:Name="CoachFullBox" Content="Passengers board fully satisfied" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Must}" Text="Turn off other g-force or passenger mods from the Workshop: only one of them can win."/>
                        <Border Style="{StaticResource ApplyBar}">
                            <StackPanel>
                                <Button Content="Apply" Click="ApplyCoach_Click" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="CoachStatus" Style="{StaticResource Status}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="HudTab" Header="HUD">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <local:PageHeader Title="HUD" Subtitle="Moves the route advisor map to the other side of the screen." Needs="Mod"
                                          Info="Mod: ets2u_ui (&quot;ETS2 Utilities: HUD&quot; in Mod Manager). To hide the coaches' g-force meter on the route advisor, use the game's own switch in its options; no mod is needed."/>

                        <local:Heading Text="Route advisor map"/>
                        <TextBlock x:Name="MapNote" Style="{StaticResource Note}"/>
                        <CheckBox x:Name="MapBox" Content="Move the route advisor map" Margin="0,6,0,0"/>
                        <StackPanel Margin="20,6,0,0">
                            <RadioButton x:Name="MapSwap" Content="Opposite side to the game's default (still follows left- or right-hand drive)" Margin="0,2"/>
                            <RadioButton x:Name="MapLeft" Content="Always bottom-left" Margin="0,2"/>
                            <RadioButton x:Name="MapRight" Content="Always bottom-right" Margin="0,2"/>
                        </StackPanel>

                        <Border Style="{StaticResource ApplyBar}">
                            <StackPanel>
                                <Button Content="Apply" Click="ApplyHud_Click" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="HudStatus" Style="{StaticResource Status}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="BusDisplayTab" Header="Destination display">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <local:PageHeader Title="Destination display" Subtitle="Your own text on the coaches' front destination display." Needs="Mod"
                                          Info="Mod: ets2u_busdisplay. Works on coaches with the &quot;standard destination display&quot; upgrade. Without {destination} in the text, it shows with or without a job, whenever the ignition is on."/>
                        <CheckBox x:Name="BusDisplayBox" Content="Show my own text on the destination display" Margin="0,8,0,0"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Route number" VerticalAlignment="Center"/>
                            <TextBox x:Name="BusRouteBox" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,3"
                                     TextChanged="BusDisplay_Changed"/>
                            <TextBlock Grid.Row="1" Text="Text" VerticalAlignment="Center"/>
                            <TextBox x:Name="BusTextBox" Grid.Row="1" Grid.Column="1" Margin="0,3" TextChanged="BusDisplay_Changed"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="Insert {destination}" Click="InsertDestination_Click"
                                    Margin="8,3,0,3" Padding="8,2"/>
                            <TextBlock Grid.Row="2" Text="Colour" VerticalAlignment="Center"/>
                            <ComboBox x:Name="BusColorBox" Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,3"
                                      SelectionChanged="BusDisplay_Changed"/>
                            <TextBlock Grid.Row="3" Text="Letter size" VerticalAlignment="Center"/>
                            <Slider x:Name="BusSizeSlider" Grid.Row="3" Grid.Column="1" Minimum="0.4" Maximum="1.2" Width="220"
                                    HorizontalAlignment="Left" Margin="0,4" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ValueChanged="BusSize_Changed"/>
                        </Grid>
                        <TextBlock Text="Preview (roughly as it looks; the game's font differs)" Foreground="#5A5A5A" Margin="0,10,0,4"/>
                        <Border Background="#121316" BorderBrush="#4A4E58" BorderThickness="3" CornerRadius="3" Width="512" Height="85"
                                HorizontalAlignment="Left" ClipToBounds="True">
                            <TextBlock x:Name="BusPreview" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        </Border>
                        <TextBlock x:Name="BusDisplayNote" Style="{StaticResource Note}" Margin="0,6,0,0"/>

                        <local:Heading Text="Saved texts"
                                       Info="Keep as many texts as you like (millions are fine): one per line in a text file, &quot;route | text&quot; or just &quot;text&quot;. Search it, pick one, apply. Only the first 1,000 matches are listed."/>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Find" VerticalAlignment="Center"/>
                            <TextBox x:Name="BusListFilter" Grid.Column="1" TextChanged="BusListFilter_Changed"/>
                        </Grid>
                        <ListBox x:Name="BusList" Height="170" VirtualizingPanel.IsVirtualizing="True"
                                 MouseDoubleClick="BusList_DoubleClick"/>
                        <TextBlock x:Name="BusListCount" Style="{StaticResource Note}"/>
                        <WrapPanel>
                            <Button Content="Use selected" Click="BusUseSelected_Click" Margin="0,0,8,6"/>
                            <Button Content="Pick one at random" Click="BusRandom_Click" Margin="0,0,8,6"/>
                            <Button Content="Save current to list" Click="BusSaveCurrent_Click" Margin="0,0,8,6"/>
                            <Button Content="Import list…" Click="BusImport_Click" Margin="0,0,8,6"/>
                            <Button Content="Open list file" Click="BusOpenList_Click" Margin="0,0,8,6"/>
                        </WrapPanel>

                        <Border Style="{StaticResource ApplyBar}">
                            <StackPanel>
                                <Button Content="Apply" Click="ApplyBusDisplay_Click" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="BusDisplayStatus" Style="{StaticResource Status}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="LiveryTab" Header="Livery pack">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}" MaxWidth="900">
                        <local:PageHeader x:Name="LiveryHeader" Title="Livery pack" Subtitle="Packs the coach liveries you choose into one optional mod." Needs="Mod"/>

                        <Border Background="#FDECEA" BorderBrush="#C62828" BorderThickness="2" CornerRadius="4" Padding="12,10" Margin="0,8,0,4">
                            <StackPanel>
                                <TextBlock Text="⚠ Respect the creators: check before you repack Workshop items" FontWeight="Bold"
                                           FontSize="14" Foreground="#9B1C1C" TextWrapping="Wrap"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#5F1414" Margin="0,4,0,0"
                                           Text="Steam Workshop liveries belong to the people who made them. Before you add one, make sure its creator allows it to be edited and redistributed: read its Workshop page (&quot;Open Workshop page&quot; below), and if it doesn't say, ask the creator. If they don't allow it, keep using their own mod instead. Never upload or share a pack with other people's work in it without their permission. The pack lists every creator in its Mod Manager description."/>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="LiveryEnabledBox" Content="Make the livery pack (optional: off by default)" Margin="0,10,0,0"/>

                        <local:Heading Text="Mods in the pack"
                                       Info="Untick a mod to leave it out without forgetting it. If two mods hold the same file, the one higher in the list wins. Click a name to rename it."/>
                        <DataGrid x:Name="LiverySourceGrid" AutoGenerateColumns="False" HeadersVisibility="Column" Height="200"
                                  GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single" CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="In" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="34"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="110" IsReadOnly="True"/>
                                <DataGridTextColumn Header="From" Binding="{Binding Where}" Width="170" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Paint jobs" Binding="{Binding PaintJobs}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Add mod file…" Click="LiveryAddFile_Click" Margin="0,0,8,6"/>
                            <Button Content="Add mod folder…" Click="LiveryAddFolder_Click" Margin="0,0,8,6"/>
                            <Button Content="Move up" Click="LiveryUp_Click" Margin="0,0,8,6"/>
                            <Button Content="Move down" Click="LiveryDown_Click" Margin="0,0,8,6"/>
                            <Button Content="Remove" Click="LiveryRemove_Click" Margin="0,0,8,6"/>
                            <Button Content="Open Workshop page" Click="LiverySourcePage_Click" Margin="0,0,8,6"/>
                            <Button x:Name="WorkshopDownloadMissingButton" Content="Download missing" Click="WorkshopDownloadMissing_Click" Margin="0,0,8,6"
                                    ToolTip="Downloads Workshop items in the list that aren't on this PC yet, or have been updated on the Workshop"/>
                        </WrapPanel>

                        <local:Heading Text="Add from the Steam Workshop by link"
                                       Info="Paste a Workshop link or ID and press Check: the app reads the item from Steam and shows what it is before anything is downloaded. Adding it downloads it into the app (with DepotDownloader), so you don't subscribe and no extra mod shows up in Mod Manager. The app checks for updates every time it starts."/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                            <TextBox x:Name="WorkshopIdBox" Width="420" Margin="0,0,8,0" KeyDown="WorkshopIdBox_KeyDown"/>
                            <Button x:Name="WorkshopCheckButton" Content="Check" Click="WorkshopCheck_Click" MinWidth="70"/>
                        </StackPanel>
                        <Border x:Name="WorkshopCheckPanel" Visibility="Collapsed" BorderBrush="#C9CED6" BorderThickness="1"
                                CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image x:Name="WorkshopPreview" Width="128" Height="128" Stretch="UniformToFill" Margin="0,0,12,0"
                                       VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="WorkshopCheckTitle" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="WorkshopCheckInfo" Style="{StaticResource Note}" Margin="0,2,0,4"/>
                                    <TextBlock x:Name="WorkshopCheckResult" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button x:Name="WorkshopAddCheckedButton" Content="Download and add" Click="WorkshopAddChecked_Click" Margin="0,0,8,6"/>
                                        <Button Content="Open Workshop page" Click="WorkshopCheckPage_Click" Margin="0,0,8,6"/>
                                        <Button Content="Cancel" Click="WorkshopCheckCancel_Click" Margin="0,0,8,6"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="WorkshopDownloadPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,6">
                            <ProgressBar x:Name="WorkshopProgress" Width="220" Height="14" Maximum="100" VerticalAlignment="Center"/>
                            <TextBlock x:Name="WorkshopDownloadText" Margin="8,0,8,0" VerticalAlignment="Center"/>
                            <Button Content="Cancel" Click="WorkshopDownloadCancel_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock x:Name="SteamAccountText" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="SteamSignOutButton" Content="Forget sign-in" Click="SteamSignOut_Click"/>
                        </StackPanel>

                        <local:Heading Text="Workshop items you're subscribed to"
                                       Info="Items Steam has already downloaded for you can be added from this list; Steam keeps them up to date. If you unsubscribe from one later, the app downloads its own copy."/>
                        <CheckBox x:Name="WorkshopLiveriesOnlyBox" Content="Only show mods with paint jobs" IsChecked="True"
                                  Margin="0,2,0,6" Click="WorkshopFilter_Click"/>
                        <DataGrid x:Name="WorkshopGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" CanUserAddRows="False" SelectionMode="Extended" Height="200"
                                  MouseDoubleClick="WorkshopAdd_Click">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="260"/>
                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="130"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90"/>
                                <DataGridTextColumn Header="Paint jobs" Binding="{Binding PaintJobs}" Width="70"/>
                                <DataGridTextColumn Header="" Binding="{Binding Note}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Add selected" Click="WorkshopAdd_Click" Margin="0,0,8,6"/>
                            <Button Content="Open Workshop page" Click="WorkshopPage_Click" Margin="0,0,8,6"/>
                            <Button Content="Refresh" Click="WorkshopRefresh_Click" Margin="0,0,8,6"/>
                        </WrapPanel>

                        <CheckBox x:Name="LiveryPermissionBox" Margin="0,10,0,0" FontWeight="SemiBold">
                            <TextBlock TextWrapping="Wrap"
                                       Text="I've checked that the creator of every Workshop item in my pack allows it to be edited and redistributed."/>
                        </CheckBox>

                        <Border Style="{StaticResource ApplyBar}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="LiveryBuildButton" Content="Save and build pack" Click="LiveryBuild_Click"/>
                                    <ProgressBar x:Name="LiveryProgress" Width="220" Height="14" Visibility="Collapsed" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="LiveryStatus" Style="{StaticResource Status}" Margin="0,6,0,0"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Must}" Text="Then enable the pack in Mod Manager and turn off the original livery mods."/>
                                    <local:InfoTip Text="So each livery isn't loaded twice. Items added by link were never subscribed, so there's nothing to turn off for them. The pack is rebuilt whenever one of its mods updates."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="OptionalTab" Header="Make optional">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}" MaxWidth="900">
                        <local:PageHeader x:Name="OptionalHeader" Title="Make optional" Subtitle="Optional copies of your mods, so Convoy players without them can still join." Needs="Mod"/>

                        <Border Background="#FDECEA" BorderBrush="#C62828" BorderThickness="2" CornerRadius="4" Padding="12,10" Margin="0,8,0,4">
                            <StackPanel>
                                <TextBlock Text="⚠ The copies are for you only" FontWeight="Bold"
                                           FontSize="14" Foreground="#9B1C1C" TextWrapping="Wrap"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#5F1414" Margin="0,4,0,0"
                                           Text="Each copy is someone else's mod with one line of its manifest changed. Keep it in your own mod folder: never upload or share it. Some creators ask that their mod isn't modified at all; check its Workshop page, and if it says so, ask them first."/>
                            </StackPanel>
                        </Border>

                        <local:Heading Text="Mods with an optional copy"
                                       Info="Untick a mod to remove its copy from the mod folder without forgetting it. Click a name to rename it (the copy shows in Mod Manager as that name with &quot;(optional)&quot;)."/>
                        <DataGrid x:Name="OptionalGrid" AutoGenerateColumns="False" HeadersVisibility="Column" Height="180"
                                  GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single" CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="On" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="34"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                                <DataGridTextColumn Header="From" Binding="{Binding Where}" Width="150" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Copy" Binding="{Binding File}" Width="200" IsReadOnly="True"/>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Add mod file…" Click="OptionalAddFile_Click" Margin="0,0,8,6"/>
                            <Button Content="Add mod folder…" Click="OptionalAddFolder_Click" Margin="0,0,8,6"/>
                            <Button Content="Remove" Click="OptionalRemove_Click" Margin="0,0,8,6"
                                    ToolTip="Forgets the mod and deletes its copy (the original isn't touched)"/>
                            <Button Content="Open Workshop page" Click="OptionalPage_Click" Margin="0,0,8,6"/>
                        </WrapPanel>

                        <local:Heading Text="Workshop items you're subscribed to"
                                       Info="Pick one or more and press Make optional. Steam keeps the originals up to date, and the app rebuilds a copy on start when its original changes."/>
                        <CheckBox x:Name="OptionalNotOptionalOnlyBox" Content="Only show mods that aren't optional yet" IsChecked="True"
                                  Margin="0,2,0,6" Click="OptionalFilter_Click"/>
                        <DataGrid x:Name="OptionalWorkshopGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" CanUserAddRows="False" SelectionMode="Extended" Height="200"
                                  MouseDoubleClick="OptionalWorkshopAdd_Click">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="280"/>
                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="130"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90"/>
                                <DataGridTextColumn Header="" Binding="{Binding Note}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Make optional" Click="OptionalWorkshopAdd_Click" Margin="0,0,8,6"/>
                            <Button Content="Open Workshop page" Click="OptionalWorkshopPage_Click" Margin="0,0,8,6"/>
                            <Button Content="Refresh" Click="OptionalRefresh_Click" Margin="0,0,8,6"/>
                        </WrapPanel>

                        <Border Style="{StaticResource ApplyBar}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="OptionalBuildButton" Content="Save and build copies" Click="OptionalBuild_Click"/>
                                    <ProgressBar x:Name="OptionalProgress" Width="220" Height="14" Visibility="Collapsed" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="OptionalStatus" Style="{StaticResource Status}" Margin="0,6,0,0"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Must}" Text="Then in Mod Manager: enable the copy and switch the original off."/>
                                    <local:InfoTip Text="So the mod isn't loaded twice and Convoy doesn't ask the other players for the original. You can stay subscribed: a subscribed mod that's switched off isn't needed to join."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= PLUGIN ================= -->
            <TabItem Header="WITH THE PLUGIN" Tag="group" IsEnabled="False" Focusable="False"/>

            <!-- The page to leave open on another screen while driving: figures, little text. It scales with the window. -->
            <TabItem x:Name="DrivingTab" Header="Driving view">
                <Grid Background="#12161B">
                    <Grid.Resources>
                        <Style TargetType="Border" x:Key="Card">
                            <Setter Property="Background" Value="#1C232B"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="Padding" Value="18,14"/>
                            <Setter Property="Margin" Value="6"/>
                        </Style>
                        <Style TargetType="TextBlock" x:Key="Label">
                            <Setter Property="Foreground" Value="#8B98A6"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                        <Style TargetType="TextBlock" x:Key="Big">
                            <Setter Property="Foreground" Value="#E8EDF2"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                        <!-- A table's row label and its value. -->
                        <Style TargetType="TextBlock" x:Key="Cell">
                            <Setter Property="Foreground" Value="#8B98A6"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,5,12,5"/>
                        </Style>
                        <Style TargetType="TextBlock" x:Key="Value">
                            <Setter Property="Foreground" Value="#E8EDF2"/>
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Margin" Value="0,5,0,5"/>
                        </Style>
                        <Style TargetType="Border" x:Key="Rule">
                            <Setter Property="BorderBrush" Value="#2A333D"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                        </Style>
                        <Style TargetType="Ellipse" x:Key="Lamp">
                            <Setter Property="Width" Value="62"/>
                            <Setter Property="Height" Value="62"/>
                            <Setter Property="Margin" Value="0,0,12,0"/>
                        </Style>
                    </Grid.Resources>
                    <Viewbox Stretch="Uniform" Margin="10">
                        <Grid Width="980">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="Auto" MinHeight="250"/>
                                <RowDefinition Height="Auto" MinHeight="300"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="330"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Top line: the game's clock and what's going on. -->
                            <DockPanel Grid.ColumnSpan="3" Margin="8,0">
                                <TextBlock x:Name="DriveClock" DockPanel.Dock="Right" Style="{StaticResource Big}" FontSize="22" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DriveState" Style="{StaticResource Label}" FontSize="16" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- The traffic light. -->
                            <Border Grid.Row="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="RECENT DRIVING"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Ellipse x:Name="DriveLampGreen" Style="{StaticResource Lamp}"/>
                                        <Ellipse x:Name="DriveLampYellow" Style="{StaticResource Lamp}"/>
                                        <Ellipse x:Name="DriveLampRed" Style="{StaticResource Lamp}" Margin="0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <TextBlock x:Name="DrivePoints" Style="{StaticResource Big}" FontSize="44"/>
                                        <TextBlock x:Name="DrivePointsOf" Style="{StaticResource Label}" FontSize="20" VerticalAlignment="Bottom" Margin="8,0,0,8"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DriveLightNote" Style="{StaticResource Label}"/>
                                </StackPanel>
                            </Border>

                            <!-- Speed. -->
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}" Text="SPEED"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock x:Name="DriveSpeed" Style="{StaticResource Big}" FontSize="96"/>
                                            <TextBlock Style="{StaticResource Label}" FontSize="20" Text="km/h" VerticalAlignment="Bottom" Margin="6,0,0,22"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DriveSpeedMph" Style="{StaticResource Label}" FontSize="20"/>
                                    </StackPanel>
                                    <Grid x:Name="DriveLimitSign" Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Ellipse Fill="White" Stroke="#D32F2F" StrokeThickness="7"/>
                                        <TextBlock x:Name="DriveLimit" FontSize="24" FontWeight="Bold" Foreground="#111"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- The job: where it's going and when, on the game's clock. -->
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="DriveJobLabel" Style="{StaticResource Label}" Text="JOB"/>
                                    <TextBlock x:Name="DriveRoute" Style="{StaticResource Big}" FontSize="24" Margin="0,4,0,4" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DriveStage" Style="{StaticResource Label}" FontSize="16" TextWrapping="Wrap"/>
                                    <Grid x:Name="DriveJobTable">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Style="{StaticResource Rule}"/>
                                        <Border Grid.Row="1" Style="{StaticResource Rule}"/>
                                        <Border Grid.Row="2" Style="{StaticResource Rule}"/>
                                        <Border x:Name="DriveEtaRule" Grid.Row="3" Style="{StaticResource Rule}"/>
                                        <TextBlock Style="{StaticResource Cell}" Text="Start"/>
                                        <TextBlock x:Name="DriveSchedStart" Grid.Column="1" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="1" Style="{StaticResource Cell}" Text="Next stop"/>
                                        <TextBlock x:Name="DriveNext" Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="2" Style="{StaticResource Cell}" Text="Due there"/>
                                        <TextBlock x:Name="DriveDue" Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}"/>
                                        <TextBlock x:Name="DriveEtaLabel" Grid.Row="3" Style="{StaticResource Cell}" Text="ETA"/>
                                        <TextBlock x:Name="DriveEta" Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="4" Style="{StaticResource Cell}" Text="End"/>
                                        <TextBlock x:Name="DriveSchedEnd" Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Events of the trip or job: a column per kind, a row per level. -->
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="SAFETY EVENTS"/>
                                    <Grid x:Name="DriveEventsTable" Margin="0,8,0,0"/>
                                </DockPanel>
                            </Border>

                            <!-- The trip or job in figures: score, totals, the latest event. -->
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                                <DockPanel>
                                    <TextBlock x:Name="DriveSummaryLabel" DockPanel.Dock="Top" Style="{StaticResource Label}" Text="SUMMARY" TextWrapping="Wrap"/>
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Label}" FontSize="12" FontWeight="Normal" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="Press F5 to clear these counts. The job's own summary keeps every event."/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" MinHeight="62"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Style="{StaticResource Rule}"/>
                                        <Border Grid.Row="1" Style="{StaticResource Rule}"/>
                                        <Border Grid.Row="2" Style="{StaticResource Rule}"/>
                                        <Border Grid.Row="3" Style="{StaticResource Rule}"/>
                                        <TextBlock Style="{StaticResource Cell}" Text="Safety score"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="DriveScore" Style="{StaticResource Big}" FontSize="44"/>
                                            <TextBlock x:Name="DriveScoreLabel" Style="{StaticResource Label}" FontSize="16" VerticalAlignment="Bottom" Margin="10,0,0,10"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Style="{StaticResource Cell}" Text="Driving"/>
                                        <TextBlock x:Name="DriveTime" Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="2" Style="{StaticResource Cell}" Text="Distance"/>
                                        <TextBlock x:Name="DriveDistance" Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="3" Style="{StaticResource Cell}" Text="Top speed"/>
                                        <TextBlock x:Name="DriveTop" Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="4" Style="{StaticResource Cell}" Text="Last event"/>
                                        <TextBlock x:Name="DriveLast" Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" FontSize="16"/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Viewbox>
                </Grid>
            </TabItem>

            <TabItem x:Name="OverlayTab" Header="Speed overlay">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <local:PageHeader Title="Speed overlay" Subtitle="Your speed in km/h and mph in a corner of the screen." Needs="Plugin|App open while driving|Borderless or windowed game"
                                          Info="The game's dashboards have one speed field and the game picks its unit, so both units can't be shown there. Instead, a small plugin reads the truck's speed and this app shows it in both units in a corner of the screen. Minimised is fine. Exclusive fullscreen may hide it."/>
                        <TextBlock x:Name="PluginStatus" Style="{StaticResource Status}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="InstallPluginButton" Content="Install plugin" Click="InstallPlugin_Click"/>
                        </StackPanel>
                        <CheckBox x:Name="OverlayBox" Content="Show the speed overlay" Margin="0,12,0,0"/>
                        <Grid Margin="20,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Corner" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CornerBox" Grid.Column="1" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Text="Size" VerticalAlignment="Center"/>
                            <Slider x:Name="ScaleSlider" Grid.Row="1" Grid.Column="1" Minimum="0.6" Maximum="3" Margin="0,4"/>
                            <CheckBox x:Name="LimitBox" Grid.Row="2" Grid.ColumnSpan="2" Content="Also show the speed limit in both units" Margin="0,4"/>
                        </Grid>
                        <Border Style="{StaticResource ApplyBar}">
                            <StackPanel>
                                <Button Content="Apply" Click="ApplyOverlay_Click" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="OverlayStatus" Style="{StaticResource Status}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AlertsTab" Header="Driving alerts">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <local:PageHeader Title="Driving alerts" Subtitle="GreenRoad-style warnings for harsh acceleration, braking, cornering and speeding."
                                          Needs="Plugin|App open while driving|Borderless or windowed game"
                                          Info="When the g-force reaches yellow or red, the alert shows on screen: harsh acceleration, braking or cornering. Coaches and trucks each have their own switch and thresholds; the app tells which you're driving. Speeding shows in red while Speeding alerts is ticked; unticked, it isn't counted anywhere, trip and job summaries included."/>
                        <TextBlock x:Name="DrivingPluginStatus" Style="{StaticResource Status}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="InstallPluginButton2" Content="Install plugin" Click="InstallPlugin_Click"/>
                        </StackPanel>

                        <!-- MOUSE DRIVING DISABLED (see MainWindow.xaml.cs, plugin ETS2U_MOUSE_DRIVING). Re-enable by removing this comment.
                        <TextBlock Style="{StaticResource H}" Text="Mouse driving, OMSI style"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Switch it on in the game with the key below. Then where the mouse is across the screen is where the wheel is: the screen's width is full left to full right lock at walking pace, and the faster you go, the further the same movement has to go, so the wheel gets heavier with speed. Above the middle of the screen is the throttle, below it the brake. Hold the right mouse button to look round: the wheel and the pedals stay where they are. Applying it changes your profiles&apos; camera so it holds still while the mouse steers and looks round as usual when mouse driving is off; turning it off puts it back. ETS2 must be closed to apply. The plugin does the driving, so this app can be closed."/>
                        <CheckBox x:Name="MouseDriveBox" Content="Let the mouse drive (switched on and off in the game)" Margin="0,6,0,0"/>
                        <Grid Margin="20,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Switch on and off with" VerticalAlignment="Center"/>
                            <ComboBox x:Name="MouseToggleBox" Grid.Column="1" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Text="Steering sensitivity" VerticalAlignment="Center"/>
                            <Slider x:Name="MouseSensSlider" Grid.Row="1" Grid.Column="1" Minimum="0.5" Maximum="3" Margin="0,4"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=MouseSensSlider, StringFormat=x{0:0.0}}"/>
                            <TextBlock Grid.Row="2" Text="Pedal strength" VerticalAlignment="Center"/>
                            <Slider x:Name="MousePedalSlider" Grid.Row="2" Grid.Column="1" Minimum="0.5" Maximum="3" Margin="0,4"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=MousePedalSlider, StringFormat=x{0:0.0}}"/>
                            <CheckBox x:Name="MouseIndicatorBox" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,4"
                                      Content="Show where the wheel and the pedals are (bottom of the screen, needs this app open)"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Apply mouse driving" Click="ApplyMouseDrive_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="MouseDriveStatus" Style="{StaticResource Note}" Margin="0,6,0,0"/>
                        END OF MOUSE DRIVING -->

                        <local:Heading Text="Alert me"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="CoachAlertsBox" Content="In coaches" Margin="0,0,24,0"/>
                            <CheckBox x:Name="TruckAlertsBox" Content="In trucks"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                            <TextBlock Text="Show them as"/>
                            <local:InfoTip Text="Tick either, both or neither: with neither, the trip and job summaries still count every event."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="20,2,0,0">
                            <CheckBox x:Name="AlertCardsBox" Content="Cards at the top of the screen"/>
                            <local:InfoTip Text="Each card says what happened and its peak g-force, and stays a few seconds after the event."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                            <CheckBox x:Name="TrafficLightBox" Content="A traffic light"/>
                            <local:InfoTip Text="Green, yellow and red lamps in a row. An event flashes yellow or red for as long as a card would show. Between events one lamp stays lit for the recent driving. The light is hidden while the game is paused."/>
                        </StackPanel>
                        <Grid Margin="40,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Where" VerticalAlignment="Center"/>
                            <ComboBox x:Name="TrafficLightCornerBox" Grid.Column="1" Margin="0,3"/>
                            <TextBlock Grid.Column="2" Text="Size" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <Slider x:Name="TrafficLightScaleSlider" Grid.Column="3" Minimum="0.6" Maximum="3" Margin="0,4"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=TrafficLightScaleSlider, StringFormat=x{0:0.0}}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="40,4,0,0">
                            <TextBlock Text="Remember events for" VerticalAlignment="Center" Width="130"/>
                            <ComboBox x:Name="TrafficLightMinutesBox" Width="60"/>
                            <TextBlock Text="in-game minutes of driving" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <local:InfoTip Text="Between events the light shows how the last stretch of driving went. Each event drops out once you've driven this far past it: 60 game minutes are about 3 real minutes on roads. Standing still or a paused game doesn't age it."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="40,6,0,0">
                            <TextBlock Text="Strictness" VerticalAlignment="Center" Width="130"/>
                            <ComboBox x:Name="TrafficLightStrictnessBox" Width="300"/>
                            <local:InfoTip Text="A yellow event counts 1 point, a red one 2. The light stays yellow or red once the remembered events reach these points, whatever the number of minutes above: Realistic yellow from 2 and red from 4 (GreenRoad over an hour), Normal 4 and 8, Relaxed 8 and 16."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <CheckBox x:Name="GMeterBox" Click="GMeter_Click" Content="Show the live g-force meter"/>
                            <local:InfoTip Text="A small floating window with now and peak in each direction, coloured by these thresholds: the same reading the alerts use. Drag it where you like; it never takes the game's focus. Works whether the alerts are on or off. Up-and-down g isn't shown: the plugin doesn't send it, and no alert uses it."/>
                        </StackPanel>
                        <local:Heading Text="Thresholds"
                                       Info="Coaches and trucks each take their thresholds from one of: the defaults (coaches 0.35 / 0.7 g, trucks 0.4 / 0.8 g, in every direction); the coach mod (the passengers' g-force limits on the Coach passengers page: yellow at the normal limit, red at the harsh one, cornering from the limit across the coach, accelerating and braking from the one along it); or your own numbers. The defaults and the coach mod can be relaxed by 10% or 20%."/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" Text="Thresholds from" Foreground="#5A5A5A"/>
                            <TextBlock Grid.Column="2" Text="Relax" Foreground="#5A5A5A"/>
                            <TextBlock Grid.Row="1" Text="Coaches" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CoachSourceBox" Grid.Row="1" Grid.Column="1" Margin="0,3,8,3" SelectionChanged="AlertSource_Changed"/>
                            <ComboBox x:Name="CoachRelaxBox" Grid.Row="1" Grid.Column="2" Margin="0,3,8,3" SelectionChanged="AlertSource_Changed"/>
                            <TextBlock Grid.Row="2" Text="Trucks" VerticalAlignment="Center"/>
                            <ComboBox x:Name="TruckSourceBox" Grid.Row="2" Grid.Column="1" Margin="0,3,8,3" SelectionChanged="AlertSource_Changed"/>
                            <ComboBox x:Name="TruckRelaxBox" Grid.Row="2" Grid.Column="2" Margin="0,3,8,3" SelectionChanged="AlertSource_Changed"/>
                        </Grid>
                        <Grid Margin="20,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="Coaches" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Grid.ColumnSpan="2" Text="Trucks" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Yellow (g)" Foreground="#8A6A00"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Red (g)" Foreground="#B3261E"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Yellow (g)" Foreground="#8A6A00"/>
                            <TextBlock Grid.Row="1" Grid.Column="5" Text="Red (g)" Foreground="#B3261E"/>
                            <TextBlock Grid.Row="2" Text="Acceleration" VerticalAlignment="Center"/>
                            <TextBox x:Name="CoachAccelYellowBox" Grid.Row="2" Grid.Column="1" Margin="0,3,8,3"/>
                            <TextBox x:Name="CoachAccelRedBox" Grid.Row="2" Grid.Column="2" Margin="0,3,8,3"/>
                            <TextBox x:Name="TruckAccelYellowBox" Grid.Row="2" Grid.Column="4" Margin="0,3,8,3"/>
                            <TextBox x:Name="TruckAccelRedBox" Grid.Row="2" Grid.Column="5" Margin="0,3,8,3"/>
                            <TextBlock Grid.Row="3" Text="Braking" VerticalAlignment="Center"/>
                            <TextBox x:Name="CoachBrakeYellowBox" Grid.Row="3" Grid.Column="1" Margin="0,3,8,3"/>
                            <TextBox x:Name="CoachBrakeRedBox" Grid.Row="3" Grid.Column="2" Margin="0,3,8,3"/>
                            <TextBox x:Name="TruckBrakeYellowBox" Grid.Row="3" Grid.Column="4" Margin="0,3,8,3"/>
                            <TextBox x:Name="TruckBrakeRedBox" Grid.Row="3" Grid.Column="5" Margin="0,3,8,3"/>
                            <TextBlock Grid.Row="4" Text="Cornering" VerticalAlignment="Center"/>
                            <TextBox x:Name="CoachCornerYellowBox" Grid.Row="4" Grid.Column="1" Margin="0,3,8,3"/>
                            <TextBox x:Name="CoachCornerRedBox" Grid.Row="4" Grid.Column="2" Margin="0,3,8,3"/>
                            <TextBox x:Name="TruckCornerYellowBox" Grid.Row="4" Grid.Column="4" Margin="0,3,8,3"/>
                            <TextBox x:Name="TruckCornerRedBox" Grid.Row="4" Grid.Column="5" Margin="0,3,8,3"/>
                        </Grid>
                        <TextBlock x:Name="CoachThresholdNote" Style="{StaticResource Note}" Margin="20,2,0,0"/>
                        <CheckBox x:Name="SpeedingBox" Margin="20,6,0,0"
                                  Content="Speeding alerts (needs a speed limit from the route advisor)"/>
                        <Border Style="{StaticResource ApplyBar}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Apply" Click="ApplyAlerts_Click"/>
                                    <Button Content="Default thresholds" Click="DefaultThresholds_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="AlertsStatus" Style="{StaticResource Status}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="TripTab" Header="Trip summary">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <local:PageHeader Title="Trip summary" Subtitle="Every harsh event of a trip, coach job or truck job, with a GreenRoad-style safety score."
                                          Needs="Plugin|App open while driving"
                                          Info="Press Start capturing before you set off and Stop capturing when you arrive. Every harsh acceleration, braking, cornering and speeding event is listed with its time, using the thresholds on the Driving alerts page for the vehicle you're in, whether the alerts show or not (speeding only while Speeding alerts is ticked). Times are the game's clock, which doesn't change with time zones. Click an event for its details. The trip is kept until you start the next one or close the app."/>
                        <TextBlock x:Name="TripPluginStatus" Style="{StaticResource Status}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <CheckBox x:Name="RecordJobsBox" Click="RecordJobs_Click" Content="Keep a summary of every coach job"/>
                            <CheckBox x:Name="RecordTruckJobsBox" Click="RecordJobs_Click" Content="and every truck job" Margin="16,0,0,0"/>
                            <local:InfoTip Text="Automatic, from when you take the job to when it's delivered or cancelled: no buttons to press. Needs the plugin and this app open for the whole job. Kept whether the driving alerts are on or off. Coach and truck jobs are kept apart, the last 200 of each; pick one under Show."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="TripSourceBox" Width="520" SelectionChanged="TripSource_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="StartTripButton" Content="Start capturing" Click="StartTrip_Click" FontWeight="SemiBold"/>
                            <Button x:Name="StopTripButton" Content="Stop capturing" Click="StopTrip_Click"/>
                            <Button x:Name="CopyTripButton" Content="Copy summary" Click="CopyTrip_Click"/>
                            <Button x:Name="ForgetJobButton" Content="Forget this job" Click="ForgetJob_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TripStatus" Style="{StaticResource Status}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="TripJobDetails" Style="{StaticResource Note}" Visibility="Collapsed"/>

                        <Border x:Name="TripTotals" Background="White" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="4"
                                Padding="16,12" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                    <Border x:Name="TripScoreBadge" Width="76" Height="76" CornerRadius="38" Background="#2E9E5B">
                                        <TextBlock x:Name="TripScoreText" Foreground="White" FontSize="26" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="TripScoreLabel" HorizontalAlignment="Center" Foreground="#5A5A5A" Margin="0,4,0,0" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TripTotalsText" FontSize="15" TextWrapping="Wrap"/>
                                    <ItemsControl x:Name="TripCounts" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,22,4">
                                                    <Grid Width="30" Height="30">
                                                        <Ellipse Fill="{Binding Fill}"/>
                                                        <Path Data="{Binding Icon}" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Margin="7"/>
                                                    </Grid>
                                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Counts}" Foreground="#5A5A5A" FontSize="12"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="White" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="4" Margin="0,12,0,0">
                            <StackPanel>
                                <DockPanel Margin="16,12">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Sort by" VerticalAlignment="Center" Foreground="#5A5A5A" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="TripSortBox" Width="110" SelectionChanged="TripSort_Changed"/>
                                        <ComboBox x:Name="TripSortDirectionBox" Width="130" Margin="6,0,0,0" SelectionChanged="TripSort_Changed"/>
                                    </StackPanel>
                                    <TextBlock Text="Safety events" FontSize="17" Foreground="#4A4A4A" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border x:Name="TripNoEvents" BorderBrush="#E3E8EE" BorderThickness="0,1,0,0">
                                    <TextBlock x:Name="TripNoEventsText" Foreground="#5A5A5A" Margin="16,14"/>
                                </Border>
                                <ItemsControl x:Name="TripEvents">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E3E8EE" BorderThickness="0,1,0,0">
                                                <StackPanel>
                                                    <Grid>
                                                    <ToggleButton x:Name="Expand" Cursor="Hand" Focusable="False" IsChecked="{Binding Expanded}">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="Back" Background="Transparent">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Back" Property="Background" Value="#F5F8FB"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                        <Grid Margin="16,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Width="56" Height="56" VerticalAlignment="Center">
                                                                <Ellipse Fill="#EFEFEF"/>
                                                                <Ellipse Fill="{Binding Fill}" Margin="5"/>
                                                                <Path Data="{Binding Icon}" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Margin="17"/>
                                                            </Grid>
                                                            <StackPanel Grid.Column="1" Margin="16,0,8,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Category}" FontSize="16"/>
                                                                <TextBlock Text="{Binding Variant}" Foreground="#8A8A8A" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Time}" Foreground="#5A5A5A"/>
                                                            </StackPanel>
                                                            <Path Grid.Column="2" Data="M 0,0 L 8,8 L 16,0" Stroke="#8A8A8A" StrokeThickness="1.5"
                                                                  VerticalAlignment="Center" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                                                                <Path.RenderTransform>
                                                                    <RotateTransform Angle="{Binding IsChecked, ElementName=Expand, Converter={StaticResource ChevronAngle}}"/>
                                                                </Path.RenderTransform>
                                                            </Path>
                                                        </Grid>
                                                    </ToggleButton>
                                                    <!-- Over the row, not in it, so a click removes without opening the row. -->
                                                    <Button Content="Remove" Click="RemoveTripEvent_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Margin="0,0,48,0" Padding="8,2" ToolTip="Take this event off the list: it no longer counts in the score"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Details}" Margin="88,0,16,12" ItemTemplate="{StaticResource KeyValueRow}"
                                                                  Visibility="{Binding IsChecked, ElementName=Expand, Converter={StaticResource BoolToVisible}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= TOOLS ================= -->
            <TabItem Header="TOOLS" Tag="group" IsEnabled="False" Focusable="False"/>

            <TabItem x:Name="MoneyTab" Header="Money &amp; XP">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <local:PageHeader Title="Money &amp; XP" Subtitle="Sets the money and truck or coach XP in a save." Needs="Game closed"
                                          Info="Edits a save in place: no mod is needed."/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Profile" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ProfileBox" Grid.Column="1" Margin="0,3" SelectionChanged="ProfileBox_Changed"/>
                            <TextBlock Grid.Row="1" Text="Save" VerticalAlignment="Center"/>
                            <ComboBox x:Name="SaveBox" Grid.Row="1" Grid.Column="1" Margin="0,3" DisplayMemberPath="Label"
                                      SelectionChanged="SaveBox_Changed"/>
                        </Grid>
                        <TextBlock x:Name="SaveStateText" Style="{StaticResource Note}" Margin="0,8,0,4"/>

                        <Grid x:Name="EditGrid" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" Text="Now" Foreground="#5A5A5A"/>
                            <TextBlock Grid.Column="2" Text="New value" Foreground="#5A5A5A"/>

                            <TextBlock Grid.Row="1" Text="Money (shared)" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MoneyNow" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
                            <TextBox x:Name="MoneyBox" Grid.Row="1" Grid.Column="2" Margin="0,3" TextChanged="XpBox_Changed"/>

                            <TextBlock Grid.Row="2" Text="Truck XP" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TruckXpNow" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
                            <TextBox x:Name="TruckXpBox" Grid.Row="2" Grid.Column="2" Margin="0,3" TextChanged="XpBox_Changed"/>
                            <TextBlock x:Name="TruckXpLevel" Grid.Row="2" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#5A5A5A"/>

                            <TextBlock Grid.Row="3" Text="Coach XP" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CoachXpNow" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"/>
                            <TextBox x:Name="CoachXpBox" Grid.Row="3" Grid.Column="2" Margin="0,3" TextChanged="XpBox_Changed"/>
                            <TextBlock x:Name="CoachXpLevel" Grid.Row="3" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#5A5A5A"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <RadioButton x:Name="SetMode" Content="Set to these values" IsChecked="True" Margin="0,0,16,0" Checked="Mode_Changed"/>
                            <RadioButton x:Name="AddMode" Content="Add these amounts" Checked="Mode_Changed"/>
                        </StackPanel>
                        <TextBlock x:Name="ModeHint" Style="{StaticResource Note}"/>

                        <TextBlock Text="Presets (each one sets a single value and leaves the others as they are now)" Foreground="#5A5A5A" Margin="0,6,0,4"/>
                        <WrapPanel>
                            <Button Content="Money 1 million" Tag="money:1000000" Click="Preset_Click" Margin="0,0,8,6"/>
                            <Button Content="Money 100 million" Tag="money:100000000" Click="Preset_Click" Margin="0,0,8,6"/>
                            <Button Content="Money 1 billion" Tag="money:1000000000" Click="Preset_Click" Margin="0,0,8,6"/>
                            <Button Content="Truck level 50" Tag="truck:50" Click="Preset_Click" Margin="0,0,8,6"/>
                            <Button Content="Truck level 100" Tag="truck:100" Click="Preset_Click" Margin="0,0,8,6"/>
                            <Button Content="Coach level 50" Tag="coach:50" Click="Preset_Click" Margin="0,0,8,6"/>
                            <Button Content="Coach level 100" Tag="coach:100" Click="Preset_Click" Margin="0,0,8,6"/>
                        </WrapPanel>

                        <TextBlock x:Name="PreviewText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>

                        <Border Style="{StaticResource ApplyBar}">
                            <StackPanel>
                                <Button x:Name="ApplySaveButton" Content="Apply to save" Click="ApplySave_Click" HorizontalAlignment="Left"/>
                                <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                           Text="The app backs up the save first. Then start the game and load this save. If Steam reports a cloud conflict, keep the files on this PC."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="InfoTab" Header="Game information">
                <Grid Margin="20,16,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <local:PageHeader Grid.ColumnSpan="3" Title="Game information" Subtitle="Fuel prices by country, and every city with its goto command."/>

                    <DockPanel Grid.Row="1">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H}" Text="Fuel prices" Margin="0,6,0,6"/>
                        <TextBlock x:Name="FuelNote" DockPanel.Dock="Top" Style="{StaticResource Note}"/>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Currency" VerticalAlignment="Center"/>
                            <ComboBox x:Name="FuelCurrencyBox" Grid.Column="1" SelectionChanged="FuelCurrency_Changed"/>
                        </Grid>
                        <DataGrid x:Name="FuelGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Country" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn x:Name="FuelPriceColumn" Header="€ per litre" Binding="{Binding PriceText}" SortMemberPath="Price" Width="105">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Cities" Binding="{Binding CityCount}" Width="55"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <DockPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H}" Text="Cities" Margin="0,6,0,6"/>
                        <TextBlock x:Name="CityNote" DockPanel.Dock="Top" Style="{StaticResource Note}"/>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Find" VerticalAlignment="Center"/>
                            <TextBox x:Name="CityFilter" Grid.Column="1" TextChanged="CityFilter_Changed"/>
                        </Grid>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="CopyGotoButton" Content="Copy goto command" Click="CopyGoto_Click"/>
                            <Button x:Name="CopyCityButton" Content="Copy name" Click="CopyCity_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="CityGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" CanUserAddRows="False" SelectionMode="Single"
                                  SelectionChanged="CityGrid_SelectionChanged" MouseDoubleClick="CityGrid_DoubleClick">
                            <DataGrid.CommandBindings>
                                <CommandBinding Command="ApplicationCommands.Copy" Executed="CityGrid_Copy"/>
                            </DataGrid.CommandBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="City" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Name in game" Binding="{Binding LocalName}" Width="*"/>
                                <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="*"/>
                                <DataGridTextColumn Header="From" Binding="{Binding Source}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="BackupsTab" Header="Backups">
                <DockPanel Margin="20,16,20,20">
                    <local:PageHeader DockPanel.Dock="Top" Title="Backups" Subtitle="Every file the app changes is copied here first." Needs="Game closed to restore"
                                      Info="Except the livery pack, which is rebuilt from its source mods. The newest 20 backups are kept."/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Restore selected" Click="Restore_Click"/>
                        <Button Content="Open backup folder" Click="OpenBackups_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="BackupGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding When}" Width="150"/>
                            <DataGridTextColumn Header="What" Binding="{Binding Reason}" Width="260"/>
                            <DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
