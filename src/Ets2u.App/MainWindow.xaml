                                </StackPanel>
                                <TextBlock x:Name="OptionalStatus" Style="{StaticResource Status}" Margin="0,6,0,0"/>
                                <TextBlock Style="{StaticResource Note}"
                                           Text="Then in Mod Manager: enable the copy and switch the original off, so the mod isn't loaded twice and Convoy doesn't ask the other players for the original. You can stay subscribed: a subscribed mod that's switched off isn't needed to join."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
